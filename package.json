{
  "name": "breathewise",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7",
    "@google-cloud/pubsub>@opentelemetry/core": "2.8.0",
    "glob": "14.0.2",
    "minimatch": "11.0.1",
    "uuid": "11.1.1"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-breathewise \"vitest run --config vitest.rules.config.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json,md}\" \"tests/**/*.{ts,tsx,json,md}\" \"e2e/**/*.{ts,tsx,json,md}\" README.md \"docs/**/*.md\" index.html package.json tsconfig.json server.ts \"server/**/*.{ts,tsx,json,md}\" playwright.config.ts vite.config.ts vitest.config.ts vitest.rules.config.ts eslint.config.mjs \".github/workflows/ci.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json,md}\" \"tests/**/*.{ts,tsx,json,md}\" \"e2e/**/*.{ts,tsx,json,md}\" README.md \"docs/**/*.md\" index.html package.json tsconfig.json server.ts \"server/**/*.{ts,tsx,json,md}\" playwright.config.ts vite.config.ts vitest.config.ts vitest.rules.config.ts eslint.config.mjs \".github/workflows/ci.yml\""
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@google/genai": "^3.6.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^10.0.1",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "axe-core": "^4.14.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.37.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "5.1.2"
  }
}
