{
  "name": "breathewise",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node --import tsx server.ts",
    "build": "node ./node_modules/vite/bin/vite.js build && node ./node_modules/esbuild/bin/esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.mjs",
    "start": "node dist-server/server.mjs",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:coverage": "node ./node_modules/vitest/vitest.mjs run --coverage",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "test:pure": "node --import tsx --test src/domain/pureLogic.node-test.ts",
    "test:all": "bun run test && bun run test:pure && bun run test:rules && bun run test:e2e",
    "test:rules": "bunx firebase-tools@15.37.0 emulators:exec --only firestore --project demo-breathewise \"bun run test:rules:vitest\"",
    "test:rules:vitest": "node ./node_modules/vitest/vitest.mjs run --config vitest.rules.config.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"src/**/*.css\" \"tests/**/*.{ts,tsx}\" \"tests/rules/**/*.spec.ts\" \"e2e/**/*.spec.ts\" README.md \"docs/**/*.md\" index.html package.json tsconfig.json server.ts \"server/**/*.ts\" playwright.config.ts vite.config.ts vitest.config.ts vitest.rules.config.ts eslint.config.mjs \".github/workflows/ci.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"src/**/*.css\" \"tests/**/*.{ts,tsx}\" \"tests/rules/**/*.spec.ts\" \"e2e/**/*.spec.ts\" README.md \"docs/**/*.md\" index.html package.json tsconfig.json server.ts \"server/**/*.ts\" playwright.config.ts vite.config.ts vitest.config.ts vitest.rules.config.ts eslint.config.mjs \".github/workflows/ci.yml\""
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^10.0.1",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.56.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.2",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "tsx": "^4.23.15",
    "vite": "^8.3.8",
    "vitest": "5.1.2"
  }
}
