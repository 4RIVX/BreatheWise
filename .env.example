# Server-side Gemini API configuration (configured via AI Studio Secrets)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# Secondary AI fallback provider (Groq - server-side only)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# CPCB / data.gov.in Open Government Data Platform API Key
DATA_GOV_IN_API_KEY=

# Strict CORS origin allowlist (comma-separated)
ALLOWED_ORIGIN=http://localhost:3000

# Client Firebase Web App Configuration (auto-populated or from firebase-applet-config.json)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
