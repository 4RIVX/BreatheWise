# AI provider orchestration (server-side only)
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq

# Primary AI provider (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# Secondary AI fallback provider (Groq - used only when AI_FALLBACK_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# CPCB / data.gov.in Open Government Data Platform API Key
DATA_GOV_IN_API_KEY=

# Strict CORS origin allowlist (comma-separated, required in production, no wildcards)
ALLOWED_ORIGIN=http://localhost:3000

# Optional distributed rate-limit store across Cloud Run instances (Redis REST / Upstash)
RATE_LIMIT_REDIS_REST_URL=
RATE_LIMIT_REDIS_REST_TOKEN=
AI_ANON_RATE_LIMIT_MAX=6
AI_AUTH_RATE_LIMIT_MAX=20
REQUIRE_AI_AUTH=false

# Client Firebase Web App Configuration (auto-populated or from firebase-applet-config.json)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
